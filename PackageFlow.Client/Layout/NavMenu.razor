<MudAppBar Elevation="1" Fixed="true" Color="Color.Primary">

    <div @onclick="NavigateToHome" class="d-flex align-items-center" style="cursor: pointer;">
        <MudImage Src="img/packageflow_logo.png" Alt="PackageFlow Logo" Height="60" ObjectFit="ObjectFit.Contain" />
    </div>

    <MudSpacer />

    <AuthorizeView>
        <Authorized Context="authState">
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    <MudChip T="string"
                             Icon="@Icons.Material.Filled.Person"
                             Color="Color.Secondary"
                             OnClick="@(() => context.ToggleAsync())"
                             Style="cursor: pointer;">
                        @(authState.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value)
                    </MudChip>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.ExitToApp" OnClick="Logout">
                        Kijelentkezés
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </Authorized>
        <NotAuthorized>
            <MudButton Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login" Href="auth/login">Bejelentkezés</MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

@code {
    [Inject] IAuthService AuthService { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private void NavigateToHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/auth/login", forceLoad: false);
    }
}
