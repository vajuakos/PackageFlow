<MudAppBar Elevation="1" Fixed="true" Color="Color.Primary">

    <div @onclick="NavigateToHome" class="d-flex align-items-center">
        <MudText Typo="Typo.h5" Class="mr-8">PackageFlow</MudText>
    </div>

    <MudSpacer />

    <MudMenuItem Icon="@Icons.Material.Filled.ExitToApp" OnClick="Logout">Kijelentkezés</MudMenuItem>

</MudAppBar>

@code {
    [Inject] IAuthService AuthService { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private void NavigateToHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: false);
    }
}
