@page "/courier/packages"

<PageTitle>Hozzám rendelt csomagok</PageTitle>

<MudPaper Elevation="2" Class="pa-4 mb-4 rounded-lg d-flex align-center">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   Class="mr-4"
                   OnClick="GoBack" />
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Hozzám rendelt csomagok</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">A felvételre vagy kiszállításra kijelölt csomagjaid listája.</MudText>
    </div>
</MudPaper>

<MudPaper Elevation="1" Class="pa-3 mb-4 rounded-lg">
    <MudGrid Spacing="3" Class="align-center">
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="searchText"
                          Placeholder="Keresés azonosító, feladó vagy címzett alapján"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="8" md="4">
            <MudSelect T="PackageStatus?"
                       @bind-Value="statusFilter"
                       Label="Státusz szűrő"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                @foreach (var status in Enum.GetValues<PackageStatus>())
                {
                    <MudSelectItem T="PackageStatus?" Value="@((PackageStatus?)status)">@status.ToDisplayName()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="2" Class="d-flex justify-end">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadPackages"
                       Disabled="isLoading">
                Frissítés
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (isLoading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto d-block my-8" />
}
else
{
    <MudTable Items="@packages"
              Filter="new Func<PackageResult, bool>(FilterPackage)"
              Hover="true"
              Dense="true"
              Elevation="1"
              Class="rounded-lg"
              RowsPerPage="15">
        <HeaderContent>
            <MudTh>Azonosító</MudTh>
            <MudTh>Státusz</MudTh>
            <MudTh>Feladó</MudTh>
            <MudTh>Címzett</MudTh>
            <MudTh>Méret/Súly</MudTh>
            <MudTh>Tervezett felvétel</MudTh>
            <MudTh Style="text-align: right;">Műveletek</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Azonosító">
                <MudText Typo="Typo.body2" Style="font-weight: 700;">@context.TrackingNumber</MudText>
            </MudTd>
            <MudTd DataLabel="Státusz">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Outlined">
                    @context.Status.ToDisplayName()
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Feladó">
                <div>@context.SenderName</div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @context.SenderAddress.PostalCode @context.SenderAddress.City, @context.SenderAddress.Street @context.SenderAddress.StreetNumber
                </MudText>
            </MudTd>
            <MudTd DataLabel="Címzett">
                <div>@context.RecipientName</div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @context.DeliveryAddress.PostalCode @context.DeliveryAddress.City, @context.DeliveryAddress.Street @context.DeliveryAddress.StreetNumber
                </MudText>
            </MudTd>
            <MudTd DataLabel="Méret/Súly">
                @context.Size (@context.WeightKg kg)
            </MudTd>
            <MudTd DataLabel="Tervezett felvétel">
                @context.ScheduledPickupDate.ToString("yyyy.MM.dd.")
            </MudTd>
            <MudTd Style="text-align: right; white-space: nowrap;">
                @if (context.Status == PackageStatus.PickupAssigned)
                {
                    <MudButton Variant="Variant.Filled"
                        Color="Color.Info"
                        Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Inventory"
                        Disabled="@(processingTrackingNumber == context.TrackingNumber)"
                        OnClick="@(() => RecordPickup(context.TrackingNumber))">
                    Felvétel rögzítése
                    </MudButton>
                 }
                 else if (context.Status == PackageStatus.DeliveryAssigned)
                 {
                     <MudButton Variant="Variant.Filled"
                        Color="Color.Warning"
                        Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.LocalShipping"
                        Disabled="@(processingTrackingNumber == context.TrackingNumber)"
                        OnClick="@(() => RecordOutForDelivery(context.TrackingNumber))">
                        Kiszállításra felvéve
                    </MudButton>
                 }
                else if (context.Status == PackageStatus.OutForDelivery)
                {
                    <div class="d-flex justify-end gap-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               Disabled="@(processingTrackingNumber == context.TrackingNumber)"
                               OnClick="@(() => RecordDelivery(context.TrackingNumber))">
                        Kézbesítve
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Cancel"
                               Disabled="@(processingTrackingNumber == context.TrackingNumber)"
                               OnClick="@(() => OpenFailDialog(context.TrackingNumber))">
                        Sikertelen
                    </MudButton>
                    </div>
                }
                 else
                 {
                     <MudText Typo="Typo.caption" Color="Color.Secondary">Nincs teendő</MudText>
                 }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="pa-6">Nincsenek hozzád rendelt csomagok!</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

<MudDialog @bind-Visible="isFailDialogOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" Class="mr-2 mb-n1" />
            Sikertelen kézbesítés rögzítése
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Azonosító: <strong>@failTrackingNumber</strong>
        </MudText>
        <MudTextField @bind-Value="failNote"
                      Label="Indoklás / Megjegyzés (opcionális)"
                      Placeholder="Pl. Címzett nem tartózkodott a címen"
                      Variant="Variant.Outlined"
                      Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseFailDialog" Disabled="@(processingTrackingNumber != null)">Mégse</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="ConfirmFailedDelivery"
                   Disabled="@(processingTrackingNumber != null)">
            Rögzítés
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    [Inject] ICourierService CourierService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    private List<PackageResult> packages = new();
    private bool isLoading = true;
    private string? processingTrackingNumber;

    private string searchText = string.Empty;
    private PackageStatus? statusFilter;

    private bool isFailDialogOpen = false;
    private string? failTrackingNumber;
    private string? failNote;

    protected override async Task OnInitializedAsync()
    {
        await LoadPackages();
    }

    private async Task LoadPackages()
    {
        isLoading = true;
        packages = await CourierService.GetAssignedPackagesAsync();
        isLoading = false;
    }

    private async Task RecordPickup(string trackingNumber)
    {
        processingTrackingNumber = trackingNumber;
        var success = await CourierService.RecordPickupAsync(trackingNumber);

        if (success)
        {
            Snackbar.Add($"A(z) {trackingNumber} csomag felvétele rögzítve.", Severity.Success);
            await LoadPackages();
        }
        else
        {
            Snackbar.Add("Nem sikerült rögzíteni a csomag felvételét!", Severity.Error);
        }

        processingTrackingNumber = null;
    }

    private async Task RecordOutForDelivery(string trackingNumber)
    {
        processingTrackingNumber = trackingNumber;
        var success = await CourierService.RecordOutForDeliveryAsync(trackingNumber);

        if (success)
        {
            Snackbar.Add($"A(z) {trackingNumber} csomag kiszállításra felvéve.", Severity.Success);
            await LoadPackages();
        }
        else
        {
            Snackbar.Add("Nem sikerült kiszállításra felvenni a csomagot!", Severity.Error);
        }

        processingTrackingNumber = null;
    }

    private async Task RecordDelivery(string trackingNumber)
    {
        processingTrackingNumber = trackingNumber;
        var success = await CourierService.RecordDeliveryAsync(trackingNumber);

        if (success)
        {
            Snackbar.Add($"A(z) {trackingNumber} csomag sikeresen kézbesítve.", Severity.Success);
            await LoadPackages();
        }
        else
        {
            Snackbar.Add("Nem sikerült rögzíteni a kézbesítést!", Severity.Error);
        }

        processingTrackingNumber = null;
    }

    private void OpenFailDialog(string trackingNumber)
    {
        failTrackingNumber = trackingNumber;
        failNote = string.Empty;
        isFailDialogOpen = true;
    }

    private void CloseFailDialog()
    {
        isFailDialogOpen = false;
        failTrackingNumber = null;
        failNote = string.Empty;
    }

    private async Task ConfirmFailedDelivery()
    {
        if (string.IsNullOrWhiteSpace(failTrackingNumber))
            return;

        var trackingNumber = failTrackingNumber;
        processingTrackingNumber = trackingNumber;

        var success = await CourierService.RecordFailedDeliveryAsync(trackingNumber, failNote);

        if (success)
        {
            Snackbar.Add($"A(z) {trackingNumber} csomag kézbesítése sikertelenként rögzítve.", Severity.Warning);
            CloseFailDialog();
            await LoadPackages();
        }
        else
        {
            Snackbar.Add("Nem sikerült rögzíteni a sikertelen kézbesítést!", Severity.Error);
        }

        processingTrackingNumber = null;
    }

    private bool FilterPackage(PackageResult package)
    {
        if (statusFilter.HasValue && package.Status != statusFilter.Value)
            return false;

        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var search = searchText.Trim();

        return Contains(package.TrackingNumber, search)
            || Contains(package.SenderName, search)
            || Contains(package.RecipientName, search)
            || Contains(package.SenderAddress.City, search)
            || Contains(package.DeliveryAddress.City, search);
    }

    private static bool Contains(string? value, string search)
        => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private static Color GetStatusColor(PackageStatus status) => status switch
    {
        PackageStatus.Registered or PackageStatus.Modified => Color.Default,
        PackageStatus.PickupAssigned or PackageStatus.DeliveryAssigned => Color.Info,
        PackageStatus.PickedUp or PackageStatus.InWarehouse => Color.Primary,
        PackageStatus.OutForDelivery => Color.Warning,
        PackageStatus.Delivered => Color.Success,
        PackageStatus.Failed or PackageStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private void GoBack() => NavigationManager.NavigateTo("/courier");
}
