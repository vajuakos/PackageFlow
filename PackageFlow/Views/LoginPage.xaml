<Page x:Class="PackageFlow.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Bejelentkezés">

    <Grid>
        <Border Width="380"
                Padding="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <ui:TextBlock Text="PackageFlow"
                              FontSize="26"
                              FontWeight="Bold"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,6" />

                <ui:TextBlock Text="Jelentkezz be a fiókodba"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,24" />

                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Felhasználónév"
                            Icon="{ui:SymbolIcon Person24}"
                            Margin="0,0,0,12" />

                <ui:PasswordBox x:Name="PasswordInput"
                                PlaceholderText="Jelszó"
                                Icon="{ui:SymbolIcon LockClosed24}"
                                Margin="0,0,0,12" />

                <ui:TextBlock Text="{Binding ErrorMessage}"
                              Foreground="IndianRed"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,12" />

                <ui:Button Content="Bejelentkezés"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Height="38"
                           Command="{Binding LoginCommand}"
                           CommandParameter="{Binding ElementName=PasswordInput}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>