<Page x:Class="PackageFlow.Views.PackageDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Csomagkezelő">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32" MaxWidth="1000" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:CardAction Grid.Column="0" 
                               Command="{Binding NavigateToCreatePackageCommand}"
                               Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                                Background="#1E293B" 
                                BorderBrush="#334155" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Width="44" Height="44" 
                                Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Add24" Foreground="#38BDF8" FontSize="20"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Új csomag rögzítése" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Csomagfeladás és előjegyzés készítése" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:CardAction>

                <ui:CardAction Grid.Column="2" 
                               Command="{Binding SearchPackageCommand}"
                               Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                                Background="#1E293B" 
                                BorderBrush="#334155" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Width="44" Height="44" 
                                Margin="0,0,16,0">
                            <ui:SymbolIcon Symbol="Search24" Foreground="#38BDF8" FontSize="20"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Csomag nyomkövetése" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Keresés csomagszám alapján" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:CardAction>
            </Grid>

            <Border Grid.Row="1" 
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="Add meg a küldemény azonosítóját (pl. PKG-2026-XXXX)"
                                Text="{Binding TrackingSearchNumber, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Search24}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchPackageCommand}"/>
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <ui:Button Grid.Column="2"
                               Appearance="Primary"
                               Content="Keresés"
                               Icon="{ui:SymbolIcon ArrowRight24}"
                               Command="{Binding SearchPackageCommand}"
                               Width="120"/>
                </Grid>
            </Border>

            <ui:InfoBar Grid.Row="2"
                        IsOpen="{Binding IsPackageNotFound}"
                        Severity="Warning"
                        Title="Nincs találat"
                        Message="{Binding ErrorMessage}"
                        Margin="0,0,0,16"/>

            <StackPanel Grid.Row="3">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FoundPackage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="KÜLDEMÉNY AZONOSÍTÓ" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding FoundPackage.TrackingNumber}" 
                                       FontSize="24" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding FoundPackage.CreatedAt, StringFormat='Rögzítve: {0:yyyy.MM.dd. HH:mm}'}" 
                                       Foreground="#94A3B8" 
                                       FontSize="13"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" 
                                Background="#1E293B" 
                                BorderBrush="#38BDF8" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="16,8"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding FoundPackage.Status}" 
                                       Foreground="#38BDF8" 
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="ArrowUpload24" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                <TextBlock Text="Feladó adatai" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <TextBlock Text="{Binding FoundPackage.SenderName}" FontWeight="Medium" FontSize="14"/>

                            <TextBlock Foreground="#94A3B8" Margin="0,2,0,0">
                                <Run Text="{Binding FoundPackage.SenderAddress.Street}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding FoundPackage.SenderAddress.StreetNumber}"/>
                            </TextBlock>

                            <TextBlock Foreground="#94A3B8">
                                <Run Text="{Binding FoundPackage.SenderAddress.PostalCode}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding FoundPackage.SenderAddress.City}"/>
                            </TextBlock>

                            <TextBlock Text="{Binding FoundPackage.SenderPhone}" Foreground="#94A3B8" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Location24" Foreground="#22C55E" Margin="0,0,8,0"/>
                                <TextBlock Text="Címzett adatai" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <TextBlock Text="{Binding FoundPackage.RecipientName}" FontWeight="Medium" FontSize="14"/>

                            <TextBlock Foreground="#94A3B8" Margin="0,2,0,0">
                                <Run Text="{Binding FoundPackage.DeliveryAddress.Street}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding FoundPackage.DeliveryAddress.StreetNumber}"/>
                            </TextBlock>

                            <TextBlock Foreground="#94A3B8">
                                <Run Text="{Binding FoundPackage.DeliveryAddress.PostalCode}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding FoundPackage.DeliveryAddress.City}"/>
                            </TextBlock>

                            <TextBlock Text="{Binding FoundPackage.RecipientPhone}" Foreground="#94A3B8" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Méretkategória" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding FoundPackage.Size}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Súly" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding FoundPackage.WeightKg, StringFormat='{}{0:N2} kg'}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Tervezett felvétel" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding FoundPackage.ScheduledPickupDate, StringFormat='{}{0:yyyy.MM.dd.}'}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <Border BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Nyomkövetési előzmények" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                        <ItemsControl ItemsSource="{Binding FoundPackage.StatusHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" 
                    BorderBrush="#1E293B" 
                    Padding="0,8,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                               Text="{Binding Timestamp, StringFormat='{}{0:yyyy.MM.dd. HH:mm}'}" 
                               Foreground="#94A3B8" 
                               FontSize="12"
                               VerticalAlignment="Center"/>

                                            <Ellipse Grid.Column="1" 
                             Width="6" Height="6" 
                             Fill="#38BDF8" 
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Left"/>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"/>
                                                <TextBlock Text="{Binding Note}" 
                                   Foreground="#94A3B8" 
                                   FontSize="12" 
                                   TextWrapping="Wrap" 
                                   Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>